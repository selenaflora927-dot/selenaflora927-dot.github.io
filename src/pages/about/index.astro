---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Spoiler from '@/components/Spoiler.astro'
import { config } from '@/site-config'
import { withBase } from '@/utils'
---
<BaseLayout title="关于" description={`关于 ${config.site.author}`}>
  <div class="animate mx-auto max-w-3xl">
    <header class="not-prose mb-8 text-center">
      <h1 class="font-serif text-3xl font-semibold">关于</h1>
      <p class="mt-3 text-ink-soft">{config.site.description}</p>
    </header>
    <div class="prose prose-fill">
      <h2>关于我</h2>
      {
        config.home.hero.about
          .split(/\n\s*\n/)
          .filter(Boolean)
          .map((paragraph) => <p>{paragraph}</p>)
      }
      <h2>关于这个站</h2>
      <p>
        「君子攸宁」，取自《诗经·小雅·斯干》，愿心安处即是归处。
      </p>
      <p>
        这里记录我的日常、折腾过程中的收获，还有一些自制的小玩意儿。写得不多的地方，就当是生活的边角料，慢慢攒。
      </p>
      <h2>联系</h2>
      <p>
        可以通过<a href={withBase('/links')}>友链</a>找到我，或者在文章下面留言。
        <Spoiler>其实我大部分时间都在折腾手机里的各种小东西。</Spoiler>
      </p>
    </div>
  </div>
</BaseLayout>